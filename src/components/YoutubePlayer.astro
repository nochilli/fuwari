---
interface Props {
	videoId?: string;
	videoURL?: string;
	title?: string;
}

const { videoId, videoURL, title = "YouTube video player" } = Astro.props;
const videoIdPattern = /^[A-Za-z0-9_-]{11}$/;

function getVideoIdFromURL(value: string): string {
	const url = new URL(value);
	const hostname = url.hostname.toLowerCase();
	const youtubeHosts = new Set([
		"youtube.com",
		"www.youtube.com",
		"m.youtube.com",
		"music.youtube.com",
		"youtu.be",
		"www.youtu.be",
		"youtube-nocookie.com",
		"www.youtube-nocookie.com",
	]);

	if (
		(url.protocol !== "http:" && url.protocol !== "https:") ||
		!youtubeHosts.has(hostname)
	) {
		throw new TypeError("YoutubePlayer requires a YouTube URL.");
	}

	const pathVideoId = url.pathname.match(/^\/(?:embed|shorts|live)\/([^/]+)/)?.[1];
	const urlVideoId =
		hostname === "youtu.be"
			? url.pathname.split("/").filter(Boolean)[0]
			: url.searchParams.get("v") ?? pathVideoId;

	if (!urlVideoId) {
		throw new TypeError("YoutubePlayer could not find a video ID in the URL.");
	}

	return urlVideoId;
}

if (videoId && videoURL) {
	throw new TypeError("Specify either videoId or videoURL, not both.");
}

const resolvedVideoId = videoURL ? getVideoIdFromURL(videoURL) : videoId;

if (!resolvedVideoId || !videoIdPattern.test(resolvedVideoId)) {
	throw new TypeError("YoutubePlayer requires an 11-character YouTube video ID.");
}
---

<div class="youtube-player">
	<iframe
		src={`https://www.youtube-nocookie.com/embed/${encodeURIComponent(resolvedVideoId)}?playsinline=1`}
		title={title}
		loading="lazy"
		referrerpolicy="strict-origin-when-cross-origin"
		allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
		allowfullscreen
	/>
</div>

<style>
	.youtube-player {
		margin: 1.5rem 0;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-large);
		background: black;
	}

	iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
