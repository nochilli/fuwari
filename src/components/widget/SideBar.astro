---
import type { MarkdownHeading } from "astro";
import Categories from "./Categories.astro";
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";

interface Props {
	class?: string;
	headings?: MarkdownHeading[];
	showProfile?: boolean;
	showCategories?: boolean;
	showTags?: boolean;
}

const {
	class: className,
	showProfile = false,
	showCategories = true,
	showTags = true,
} = Astro.props;
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div id="sidebar-sticky" class="transition-all duration-700 flex flex-col w-full gap-4 top-4 sticky top-4">
        <div
            id="profile-card"
            class:list={[
                "grid overflow-hidden transition-all duration-300 motion-reduce:transition-none",
                {
                    "grid-rows-[1fr] opacity-100 translate-y-0": showProfile,
                    "grid-rows-[0fr] opacity-0 translate-y-8 -mb-4 pointer-events-none": !showProfile,
                },
            ]}
            data-visible={showProfile ? "true" : "false"}
            aria-hidden={!showProfile}
            inert={!showProfile}
        >
            <div class="min-h-0 overflow-hidden">
                <Profile />
            </div>
        </div>
        <div
            id="categories-card"
            class:list={[
                "grid transition-all card-base duration-300 motion-reduce:transition-none",
                {
                    "grid-rows-[1fr] opacity-100 translate-y-0": showCategories,
                    "grid-rows-[0fr] opacity-0 translate-y-8 -mb-4 pointer-events-none": !showCategories,
                },
            ]}
            data-visible={showCategories ? "true" : "false"}
            aria-hidden={!showCategories}
            inert={!showCategories}
        >
            <Categories class="onload-animation" style="animation-delay: 150ms"></Categories>
        </div>
        <div
            id="tags-card"
            class:list={[
                "grid transition-all card-base duration-300 motion-reduce:transition-none",
                {
                    "grid-rows-[1fr] opacity-100 translate-y-0": showTags,
                    "grid-rows-[0fr] opacity-0 translate-y-8 -mb-4 pointer-events-none": !showTags,
                },
            ]}
            data-visible={showTags ? "true" : "false"}
            aria-hidden={!showTags}
            inert={!showTags}
        >
            <Tag class="onload-animation" style="animation-delay: 200ms"></Tag>
        </div>
    </div>
</div>
